# PostgreSQL recommended. SQLite also works for a quick local demo.
DATABASE_URL=sqlite:///./aivoa.db

# Create at https://console.groq.com/keys
GROQ_API_KEY=

# Assignment requested Gemma 2 9B IT. Groq deprecated this model on 2025-10-08.
# Keep this value if your provided assignment environment still exposes it.
# Otherwise use the current fallback model below.
GROQ_MODEL=gemma2-9b-it
GROQ_FALLBACK_MODEL=llama-3.1-8b-instant

# Set false for the real Groq workflow. true lets the UI run without an API key.
AI_MOCK_MODE=false

CORS_ORIGINS=http://localhost:5173
